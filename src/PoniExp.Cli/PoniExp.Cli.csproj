<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>PoniExp.Cli</RootNamespace>
    <AssemblyName>poniexp-client</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Self-contained single-file builds (scripts/publish.sh): the bundled SQLite library unpacks next to it on first run. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../PoniExp.Client/PoniExp.Client.csproj" />
    <ProjectReference Include="../PoniExp.Secrets/PoniExp.Secrets.csproj" />
    <ProjectReference Include="../PoniExp.Daemon/PoniExp.Daemon.csproj" />
    <ProjectReference Include="../PoniExp.Mcp/PoniExp.Mcp.csproj" />
  </ItemGroup>
</Project>
