<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>PoniExp.Server</RootNamespace>
    <AssemblyName>poniexp</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- The Dockerfile restores from the .csproj alone; without this the SDK sees no .razor files then and leaves out blazor.web.js. -->
    <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../PoniExp.Core/PoniExp.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="PoniExp.Tests" />
  </ItemGroup>
</Project>
